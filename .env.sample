# rename this `.env.sample` file to `.env`
VITE_APP_KAKAOMAP_JAVASCRIPT_KEY=${ENTER_YOUR_VITE_APP_KAKAOMAP_JAVASCRIPT_KEY}
# P2-B3: leave the base empty when the API is same-origin; set it to the local Worker URL for local integration.
VITE_ADMIN_API_BASE_URL=
# Only for local development with a synthetic Access JWT. Do not set in production.
VITE_ADMIN_TEST_JWT=
# Use local-test only for the legacy synthetic localStorage adapter; API is the default.
VITE_ADMIN_REPOSITORY_MODE=
